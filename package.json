{
  "name": "wealthpulseai",
  "version": "1.1.0",
  "description": "WealthPulse AI — Portföy takibi ve Monte Carlo simülasyonu. Hisse, altın, döviz, fon ve kripto varlıklarınızı TL bazında izleyin, enflasyona göre olası gelecek senaryolarını görün.",
  "author": {
    "name": "Oğuz K.",
    "email": "kaptanoguz@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "electron-main.js",
  "homepage": "https://github.com/kaptanoguz/WealthPulse",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaptanoguz/WealthPulse.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON lib/__tests__/*.test.ts",
    "electron:dev": "electron . --dev",
    "dist:linux": "npm run build:desktop && electron-builder --linux --publish never",
    "build:desktop": "next build && node scripts/prepare-standalone.mjs",
    "electron:start": "npm run build:desktop && electron .",
    "dist:win": "npm run build:desktop && electron-builder --win --publish never",
    "dist:mac": "npm run build:desktop && electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.wealthpulse.ai",
    "productName": "WealthPulse",
    "artifactName": "WealthPulse-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron-main.js",
      "package.json",
      "public/icon.png",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app-server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WealthPulse"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "category": "public.app-category.finance"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "category": "Finance",
      "synopsis": "Portfolio tracking and Monte Carlo projections",
      "description": "WealthPulse - TL bazında portföy takibi ve enflasyon düzeltmeli Monte Carlo simülasyonu."
    }
  },
  "dependencies": {
    "@mantine/charts": "^8.3.15",
    "@mantine/core": "^8.3.15",
    "@mantine/dates": "^8.3.15",
    "@mantine/hooks": "^8.3.15",
    "@mantine/modals": "^8.3.15",
    "@mantine/notifications": "^8.3.15",
    "@mantine/spotlight": "^8.3.15",
    "@tabler/icons-react": "^3.38.0",
    "dayjs": "^1.11.19",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "yahoo-finance2": "^3.13.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^40.7.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "postcss": "^8.5.8",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5"
  }
}
